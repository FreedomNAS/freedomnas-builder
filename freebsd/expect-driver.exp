#!/usr/bin/expect -f
# freebsd/expect-driver.exp — QEMU backend serial-console handoff
# (fallback path; see qemu-driver.sh and vbox-driver.sh's header for why
# VirtualBox is the default).
#
# CORRECTED assumption: mfsBSD does NOT auto-login on the console --
# confirmed empirically (via the VirtualBox path, where QEMU itself
# never got far enough to show it) -- it presents a normal `login:`
# prompt. Credentials are mfsBSD's well-known static default: root /
# mfsroot. The very first version of this script wrongly assumed
# auto-login and would have hung here even if the underlying QEMU boot
# hang (still unresolved on the validation hardware -- see
# qemu-driver.sh) had not existed.
#
# All real build logic still lives in build-in-guest.sh, not here --
# this file's job is strictly: wait for login:, send credentials, wait
# for a shell prompt, send one command, wait for the completion marker.
#
# Usage: expect-driver.exp <qemu-command-string>
# Exits 0 on FNAS_BUILD_MARKER_SUCCESS, 1 on FNAS_BUILD_MARKER_FAILED,
# an unhandled eof, or timeout.
set timeout 1800
set qemu_cmd [lindex $argv 0]

log_user 1
spawn -noecho sh -c $qemu_cmd

expect {
    -re {login:\s*$} { }
    eof     { puts "expect-driver: guest/QEMU exited before reaching the login prompt"; exit 1 }
    timeout { puts "expect-driver: TIMEOUT waiting for the login prompt"; exit 1 }
}
send "root\r"

expect {
    -re {Password:\s*$} { }
    eof     { puts "expect-driver: guest/QEMU exited before the password prompt"; exit 1 }
    timeout { puts "expect-driver: TIMEOUT waiting for the password prompt"; exit 1 }
}
send "mfsroot\r"

expect {
    -re {root@\S+:.*#\s*$} { }
    eof     { puts "expect-driver: guest/QEMU exited before reaching a shell prompt (wrong password?)"; exit 1 }
    timeout { puts "expect-driver: TIMEOUT waiting for a shell prompt after login"; exit 1 }
}

send "mkdir -p /fnas-seed && mount -t 9p -o trans=virtio,version=9p2000.L fnas_seed /fnas-seed && sh /fnas-seed/build-in-guest.sh\r"

expect {
    "FNAS_BUILD_MARKER_SUCCESS" { }
    "FNAS_BUILD_MARKER_FAILED"  { puts "expect-driver: guest reported build failure"; exit 1 }
    eof     { puts "expect-driver: guest/QEMU exited before signaling build completion"; exit 1 }
    timeout { puts "expect-driver: TIMEOUT waiting for build completion"; exit 1 }
}

# Guest calls `poweroff -p`; wait for QEMU itself to exit.
expect eof
exit 0
